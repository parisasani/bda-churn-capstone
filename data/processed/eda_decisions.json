      },
      {
        "feature": "Total day minutes",
        "operator": ">=",
        "threshold": "t"
      }
    ],
    "ranking": [
      {
        "key": "rule_score",
        "ascending": false
      },
      {
        "key": "Total day minutes",
        "ascending": false
      },
      {
        "key": "random",
        "ascending": true,
        "seed": 42
      }
    ],
    "sensitivity_drops": "Customer service calls"
  }
