{
  "source_notebook": "02_eda.ipynb",
  "random_seed": 42,
  "initial_features": {
    "categorical": [
      "State",
      "Area code",
      "International plan",
      "Voice mail plan"
    ],
    "numeric": [
      "Account length",
      "Number vmail messages",
      "Total day minutes",
      "Total day calls",
      "Total eve minutes",
      "Total eve calls",
      "Total night minutes",
      "Total night calls",
      "Total intl minutes",
      "Total intl calls",
      "Customer service calls"
    ],
    "excluded": [
      "Total day charge",
      "Total eve charge",
      "Total night charge",
      "Total intl charge"
    ]
  },
  "options_for_cross_validation": {
    "state_handling": [
      "one_hot_regularised",
      "exclude"
    ],
    "voicemail_features": [
      "both",
      "plan_only",
      "messages_only"
    ]
  },
  "evaluation": {
